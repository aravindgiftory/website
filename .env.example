# Copy to .env and fill after you deploy the Apps Script web app.
# These VITE_ values are bundled into the public site — never put secrets here.

VITE_LEADS_SCRIPT_URL=
# Public site origin (used for canonical URLs, sitemap, social previews)
VITE_SITE_URL=https://aravindgiftory.com
# Optional Google Analytics 4 ID, loaded only after cookie consent
VITE_GA_ID=
# Set to true on any staging or preview build so search engines never index it.
# Leave unset in production. Local development is always noindex.
VITE_NOINDEX=
